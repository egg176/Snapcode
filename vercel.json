{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 npm run build && find build -name '*.map' -delete",
  "outputDirectory": "build",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  }
}
